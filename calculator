import gradio as gr


expression = ""

def update_expression(new_value):
    """Appends a new character or operator to the expression."""
    global expression
    expression += str(new_value)
    return expression

def clear_expression():
    """Clears the current expression."""
    global expression
    expression = ""
    return ""

def calculate_expression():
    """Evaluates the current expression safely."""
    global expression
    try:
        expr = expression.replace("÷", "/").replace("×", "*").replace("^", "**")
        result = str(eval(expr))
    except Exception:
        result = "Error"
    expression = ""  
    return result


with gr.Blocks(title="Calculator") as app:
    gr.Markdown("## 🧮 Simple Calculator")

    result_box = gr.Textbox(label="Result", interactive=False)


    def make_row(*labels):
        with gr.Row():
            for label in labels:
                btn = gr.Button(label)
                if label == "=":
                    btn.click(calculate_expression, outputs=result_box)
                elif label == "C":
                    btn.click(clear_expression, outputs=result_box)
                else:
                    btn.click(update_expression, inputs=gr.Textbox(value=label, visible=False), outputs=result_box)

 
    make_row("7", "8", "9", "÷")
    make_row("4", "5", "6", "×")
    make_row("1", "2", "3", "-")
    make_row("0", ".", "+", "=")
    make_row("^", "%", "//", "C")


if __name__ == "__main__":
    app.launch()
